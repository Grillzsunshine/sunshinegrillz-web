<style>
@font-face{font-family:'Bodoni Moda';font-style:normal;font-weight:400 900;font-display:swap;src:url(/fonts/bodoni-moda.woff2) format('woff2')}
@font-face{font-family:'Familjen Grotesk';font-style:normal;font-weight:400 700;font-display:swap;src:url(/fonts/familjen-grotesk.woff2) format('woff2')}
:root{--paper:#F7F2E8;--ink:#1D1812;--ink-2:#5C5346;--gold:#9C7A21;--gold-2:#D4A843;--line:rgba(29,24,18,.12);--card:#FFFDF8}
*{box-sizing:border-box}
html{color-scheme:light}
body{margin:0;background:var(--paper);color:var(--ink);font-family:'Familjen Grotesk','Helvetica Neue',Arial,sans-serif;line-height:1.55;font-size:17px}
.wrap{width:min(720px,calc(100% - 40px));margin:0 auto;padding:40px 0 90px}
h1,h2{font-family:'Bodoni Moda','Didot',serif;font-weight:500;line-height:1.05;letter-spacing:-.005em;margin:0}
h1{font-size:clamp(38px,7vw,58px)}
h2{font-size:clamp(26px,4vw,34px);margin:56px 0 14px;padding-top:28px;border-top:1px solid var(--line)}
h3{font-size:18px;margin:26px 0 8px}
.eyebrow{font-size:11px;letter-spacing:.26em;text-transform:uppercase;color:var(--gold);font-weight:600;margin:0 0 14px}
.lead{font-size:19px;color:var(--ink-2);margin:16px 0 0}
p{margin:10px 0}
ol,ul{padding-left:22px;margin:10px 0}
li{margin:8px 0}
li::marker{color:var(--gold);font-weight:700}
kbd,.ui{display:inline-block;padding:1px 8px;border:1px solid var(--line);border-radius:6px;background:var(--card);font-size:15px;font-weight:600;white-space:nowrap}
.card{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:18px 20px;margin:16px 0}
.card.gold{border-color:rgba(156,122,33,.35);background:#FBF5E4}
.card b{color:var(--ink)}
a{color:var(--gold);font-weight:600}
.pill{display:inline-flex;align-items:center;gap:8px;padding:6px 12px;border-radius:999px;background:#1D1812;color:#F1D48A;font-size:13px;font-weight:600;letter-spacing:.04em}
.grid{display:grid;gap:12px;margin:14px 0}
@media(min-width:600px){.grid{grid-template-columns:1fr 1fr}}
.grid .card{margin:0}
.grid h3{margin-top:0}
small{color:var(--ink-2)}
.toc{columns:2;gap:24px;font-size:15px}
@media(max-width:520px){.toc{columns:1}}
.toc a{font-weight:500;color:var(--ink)}
</style>
